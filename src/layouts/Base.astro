---
import '../estilos/global.css'

interface Props { titulo: string; descripcion?: string }
const { titulo, descripcion = 'Proyecto personal de estudio de la Licenciatura en Administración y Gestión de la Información (UNRaf).' } = Astro.props
const base = import.meta.env.BASE_URL
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={descripcion} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#15120d" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f4efe6" media="(prefers-color-scheme: light)" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <title>{titulo}</title>
    <!-- Tema antes del primer pintado: evita el parpadeo entre claro y oscuro. -->
    <script is:inline>
      (function () {
        try {
          var p = JSON.parse(localStorage.getItem('mkt-unraf-2026:progreso:v1') || '{}');
          var t = p.tema || 'auto';
          var tam = p.tamano || 'normal';
          var root = document.documentElement;
          root.dataset.tema = t;
          if (tam !== 'normal') root.classList.add('tamano-' + tam);
        } catch (e) { document.documentElement.dataset.tema = 'auto'; }
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
