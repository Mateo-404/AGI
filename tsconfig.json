{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "src", "contenido", "scripts", "tests", "astro.config.mjs"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "types": ["bun", "astro/client"],
    "paths": { "@contenido/*": ["./contenido/*"], "@/*": ["./src/*"] }
  }
}
