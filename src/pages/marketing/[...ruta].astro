---
import CursoMateria from '../../componentes/CursoMateria.astro'
import { paginasDe } from '../../logica/rutas'

/** Una página HTML real por cada ruta del curso: /AGI/marketing, /AGI/marketing/leccion/l2-1, etc. */
export const getStaticPaths = () => paginasDe('marketing')

const { sub } = Astro.props as { sub: string[] }
---
<CursoMateria materia="marketing" sub={sub} />
